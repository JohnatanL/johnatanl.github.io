---
import type { ProjectEntry } from '../../utils/content';
import { FEATURE_SCOPE_META, type FeatureScope } from '../../utils/format';
import StatusBadge from '../ui/StatusBadge.astro';

interface Props {
  features: ProjectEntry['data']['features'];
}

const { features } = Astro.props;
const scopesOrder: FeatureScope[] = ['implementado', 'demostracion-visual', 'en-progreso'];
const grouped = scopesOrder
  .map((scope) => ({
    scope,
    meta: FEATURE_SCOPE_META[scope],
    items: features.filter((f) => f.scope === scope),
  }))
  .filter((group) => group.items.length > 0);
---

<div class="feature-groups">
  {
    grouped.map((group) => (
      <div class="feature-group card">
        <div class="feature-group__header">
          <StatusBadge label={group.meta.label} tone={group.meta.tone} />
          <p class="feature-group__desc">{group.meta.description}</p>
        </div>

        <ul class="feature-group__list">
          {group.items.map((item) => (
            <li class="feature-group__item">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .feature-groups {
    display: grid;
    gap: var(--space-5);
  }

  .feature-group__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .feature-group__desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .feature-group__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .feature-group__item h3 {
    font-size: var(--text-base);
    color: var(--color-text-primary);
  }

  .feature-group__item p {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
</style>

