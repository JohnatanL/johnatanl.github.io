---
import type { ProjectEntry } from '../../utils/content';

interface Props {
  challenges: ProjectEntry['data']['challenges'];
}

const { challenges } = Astro.props;
---

{
  challenges.length > 0 && (
    <div class="challenge-list">
      {challenges.map((entry, idx) => (
        <article class="challenge-item card">
          <p class="challenge-item__index">Reto técnico 0{idx + 1}</p>
          <div class="challenge-item__grid">
            <div>
              <h3>Problema enfrentado</h3>
              <p>{entry.challenge}</p>
            </div>
            <div>
              <h3>Solución aplicada</h3>
              <p>{entry.solution}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  )
}

<style>
  .challenge-list {
    display: grid;
    gap: var(--space-4);
  }

  .challenge-item__index {
    font-family: var(--font-mono, monospace);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent-blue);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-3);
  }

  .challenge-item__grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 720px) {
    .challenge-item__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }

  .challenge-item h3 {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
    margin-bottom: 0.35rem;
  }

  .challenge-item p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
</style>

