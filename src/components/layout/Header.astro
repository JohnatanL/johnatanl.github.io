---
import { siteConfig } from '../../data/site';
import { isCurrentRoute, withBase } from '../../utils/paths';
import MobileNav from './MobileNav.astro';

const currentPathname = Astro.url.pathname;
---

<header class="site-header surface-dark">
  <div class="container site-header__inner">
    <a class="site-brand" href={withBase('/')} aria-label={`${siteConfig.author.name} — Inicio`}>
      <span class="site-brand__mark" aria-hidden="true">JL</span>
      <span class="site-brand__text">
        <span class="site-brand__name">{siteConfig.author.name}</span>
        <span class="site-brand__role">{siteConfig.author.shortRole}</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul class="desktop-nav__list">
        {
          siteConfig.navigation.map((item) => {
            const active = isCurrentRoute(currentPathname, item.href);
            return (
              <li>
                <a
                  href={withBase(item.href)}
                  class:list={['desktop-nav__link', { 'is-active': active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <MobileNav items={siteConfig.navigation} currentPathname={currentPathname} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(16, 24, 39, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border-dark);
  }

  .site-header__inner {
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-dark-text-primary);
  }

  .site-brand:hover {
    color: var(--color-dark-text-primary);
  }

  .site-brand__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 0.55rem;
    background-color: var(--color-navy-800);
    border: 1px solid rgba(116, 212, 229, 0.45);
    color: var(--color-accent-cyan);
    font-family: var(--font-heading, sans-serif);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
  }

  .site-brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .site-brand__name {
    font-family: var(--font-heading, sans-serif);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--color-dark-text-primary);
  }

  .site-brand__role {
    font-size: 0.75rem;
    color: var(--color-dark-text-muted);
  }

  @media (max-width: 420px) {
    .site-brand__role {
      display: none;
    }
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 960px) {
    .desktop-nav {
      display: block;
    }
  }

  .desktop-nav__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }

  .desktop-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-sm);
    color: var(--color-dark-text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .desktop-nav__link:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: var(--color-dark-text-primary);
  }

  .desktop-nav__link.is-active {
    background-color: var(--color-accent-cyan-soft);
    color: var(--color-accent-cyan);
    font-weight: 600;
  }
</style>

